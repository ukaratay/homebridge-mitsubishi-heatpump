{
  "name": "homebridge-mitsubishi-heatpump",
  "version": "2.2.2",
  "description": "Homebridge plugin for Mitsubishi ductless heat pumps (MLZ/MSZ) over the Mitsubishi Comfort v3 API, with local LAN control, fan speed and vane control",
  "author": "Durmus Karatay",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test dist-test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "build:test": "node --eval \"fs.rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json"
  },
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "mitsubishi",
    "heat-pump",
    "mini-split",
    "heatercooler",
    "hvac",
    "mlz",
    "msz"
  ],
  "engines": {
    "node": ">=20.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukaratay/homebridge-mitsubishi-heatpump.git"
  },
  "bugs": {
    "url": "https://github.com/ukaratay/homebridge-mitsubishi-heatpump/issues"
  },
  "homepage": "https://github.com/ukaratay/homebridge-mitsubishi-heatpump#readme",
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "homebridge": "^2.2.1",
    "typescript": "^5.9.3"
  }
}
